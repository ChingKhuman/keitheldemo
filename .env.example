# Copy this file to .env and fill it in. Never commit .env.

# PostgreSQL connection string.
# Local example:  postgresql://postgres:password@localhost:5432/keithel
DATABASE_URL=postgresql://postgres:password@localhost:5432/keithel

# Set to true when the database requires SSL (Render's external connection string does).
# Render's internal connection string does not need it.
DATABASE_SSL=false

# Comma-separated mobile numbers that get the Admin page (verify sellers, hide listings).
# Create an account with this number first, then it becomes an admin.
ADMIN_PHONES=9284236426

# Public address of the site, used for search engines and link previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
